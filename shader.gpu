const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent;
attribute vec2 texCoord;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;

varying vec3 vEyePosition;
varying vec3 vNormal;
varying vec3 vTangent;
varying vec2 vTexCoord;

void main() {
    vec4 pos = ModelViewMatrix * vec4(vertex, 1.0);
    vEyePosition = pos.xyz;
    vNormal = mat3(ModelViewMatrix) * normal;
    vTangent = mat3(ModelViewMatrix) * tangent;
    vTexCoord = texCoord;
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}
`;

const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif

uniform sampler2D diffuseMap;
uniform sampler2D specularMap;
uniform sampler2D normalMap;
uniform vec3 lightPosition;
uniform bool useNormalMap;

varying vec3 vEyePosition;
varying vec3 vNormal;
varying vec3 vTangent;
varying vec2 vTexCoord;

void main() {
    vec3 N = normalize(vNormal);
    vec3 T = normalize(vTangent - dot(vTangent, N) * N);
    vec3 B = normalize(cross(N, T));

    vec3 mappedNormal = texture2D(normalMap, vTexCoord).rgb * 2.0 - 1.0;
    vec3 finalNormal = useNormalMap ? normalize(mat3(T, B, N) * mappedNormal) : N;

    vec3 L = normalize(lightPosition - vEyePosition);
    vec3 V = normalize(-vEyePosition);
    vec3 R = reflect(-L, finalNormal);

    vec3 baseColor = texture2D(diffuseMap, vTexCoord).rgb;
    vec3 specColor = texture2D(specularMap, vTexCoord).rgb;

    vec3 ambient = 0.14 * baseColor;
    float diff = max(dot(finalNormal, L), 0.0);
    vec3 diffuse = 0.82 * diff * baseColor;

    float spec = 0.0;
    if (diff > 0.0) spec = pow(max(dot(R, V), 0.0), 32.0);
    vec3 specular = 0.85 * spec * specColor;

    gl_FragColor = vec4(ambient + diffuse + specular, 1.0);
}
`;
